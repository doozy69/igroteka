{
  "port": 8102, // Порт, на котором запускается сервер (можно переопределить переменной окружения PORT)
  "questionsDir": "questions", // Папка с JSON-паками вопросов (относительно корня проекта)
  "specials": { // Настройки случайных спецвопросов (Кот в мешке / Аукцион)
    "round1": { // Параметры для 1 раунда
      "cats": { "min": 1, "max": 2 }, // Количество "Котов в мешке" в 1 раунде (случайно от min до max)
      "auctions": { "min": 1, "max": 2 } // Количество "Аукционов" в 1 раунде (случайно от min до max)
    },
    "round2": { // Параметры для 2 раунда
      "cats": { "min": 2, "max": 2 }, // Количество "Котов в мешке" во 2 раунде (случайно от min до max)
      "auctions": { "min": 2, "max": 2 } // Количество "Аукционов" во 2 раунде (случайно от min до max)
    },
    "round3": { // Параметры для 3 раунда
      "cats": { "min": 2, "max": 3 }, // Количество "Котов в мешке" в 3 раунде (случайно от min до max)
      "auctions": { "min": 2, "max": 3 } // Количество "Аукционов" в 3 раунде (случайно от min до max)
    }
  },
  "catBet": { // Ставка в «Коте в мешке»: доступны только две суммы — минимум и максимум раунда
    "round1": { // Параметры ставки для 1 раунда
      "min": null, // Первая (минимальная) ставка; null — минимальный номинал вопросов раунда из пака (100)
      "max": null, // Вторая (максимальная) ставка; null — максимальный номинал вопросов раунда из пака (500)
      "note": "Игрок называет одну из двух ставок: {min} или {max}" // Подсказка на ТВ и телефонах; {min} и {max} подставляются автоматически
    },
    "round2": { // Параметры ставки для 2 раунда
      "min": null, // Первая (минимальная) ставка; null — минимальный номинал вопросов раунда из пака (200)
      "max": null, // Вторая (максимальная) ставка; null — максимальный номинал вопросов раунда из пака (1000)
      "note": "Игрок называет одну из двух ставок: {min} или {max}" // Подсказка на ТВ и телефонах; {min} и {max} подставляются автоматически
    },
    "round3": { // Параметры ставки для 3 раунда
      "min": null, // Первая (минимальная) ставка; null — минимальный номинал вопросов раунда из пака (300)
      "max": null, // Вторая (максимальная) ставка; null — максимальный номинал вопросов раунда из пака (1500)
      "note": "Игрок называет одну из двух ставок: {min} или {max}" // Подсказка на ТВ и телефонах; {min} и {max} подставляются автоматически
    }
  },
  "catQuestions": { // Банк вопросов для «Кота в мешке» (отдельно от паков)
    "dir": "questions/cats" // Папка с JSON-файлами банка; можно указать свой путь (в т.ч. абсолютный)
  },
  "game": { // Общие настройки игры
    "allowPlayersReconnect": true, // Разрешать игрокам переподключаться в ту же комнату с сохранением игрока
    "showSpecialMarkersToAdmin": true, // Показывать администратору пометки спецвопросов на табло
    "showSpecialMarkersToTV": false, // Показывать на ТВ-экране пометки спецвопросов на табло
    "autoCloseQuestionOnCorrect": false // Не закрывать вопрос автоматически после верного ответа — ведущий закроет его сам
  },
  "editor": { // Редактор паков и загрузка картинок (/editor.html)
    "token": "" // Токен для доступа по сети; пусто — редактор доступен только с этого компьютера
  },
  "images": { // Обработка картинок вопросов в редакторе
    "maxBytes": 8388608, // Максимальный размер исходной картинки, байт (8 МБ)
    "maxWidth": 2560, // Максимальная ширина после сжатия
    "maxHeight": 1440, // Максимальная высота после сжатия
    "quality": 82 // Качество WebP (40…100)
  },
  "sound": { // Звуковое оформление — звуки играют ТОЛЬКО на экране ТВ (файлы в public/sounds, лицензии — public/sounds/CREDITS.md)
    "enabled": true, // Включать звуки игры; кнопка 🔊 на ТВ-экране отключает звук локально
    "volume": 0.8, // Общая громкость от 0 (беззвучно) до 1 (максимум)
    "events": { // Какой файл и с какой громкостью играть в каждом сценарии (volume — доля от общей громкости)
      "roundStart": { "file": "round.mp3", "volume": 0.85 }, // Начало 1/2/3 раунда — фанфары
      "questionOpen": { "file": "reveal.mp3", "volume": 0.60 }, // Открытие обычного вопроса или показ скрытого вопроса кота/аукциона
      "cat": { "file": "cat.mp3", "volume": 0.85 }, // Выпал «Кот в мешке» (до передачи игроку)
      "auction": { "file": "auction.mp3", "volume": 0.85 }, // Выпал «Аукцион» (до назначения ставки)
      "buzz": { "file": "buzz.mp3", "volume": 0.90 }, // Игрок первым нажал кнопку
      "correct": { "file": "correct.mp3", "volume": 0.90 }, // Правильный ответ
      "wrong": { "file": "wrong.mp3", "volume": 0.85 }, // Неправильный ответ
      "final": { "file": "final.mp3", "volume": 0.35, "loop": true }, // Начало финала — тиканье часов (зациклено)
      "finish": { "file": "applause.mp3", "volume": 0.80 } // Завершение игры — аплодисменты
    }
  }
}
