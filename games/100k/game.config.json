{
  "port": 8101, // Порт сервера (можно переопределить переменной окружения PORT; если занят — сервер возьмёт следующий свободный)
  "questionsDir": "questions", // Папка с JSON-паками вопросов (относительно корня проекта)
  "game": {
    "defaultTeams": [
      { "id": "team1", "name": "Команда 1" },
      { "id": "team2", "name": "Команда 2" }
    ],
    "bigGameTarget": 200, // Порог победы в «Большой игре»
    "maxStrikes": 3, // Количество промахов до блиц-опроса
    "allowPlayersReconnect": true, // Разрешать игрокам переподключаться
    "timers": {
      "reverseDiscussionSec": 20, // Совещание в «Игре наоборот»
      "bigGamePlayer1Sec": 20, // Время первого игрока в «Большой игре»
      "bigGamePlayer2Sec": 30 // Время второго игрока
    },
    "reversePointsByRank": [15, 30, 60, 120, 180, 240] // Очки за строки 1–6 в «Игре наоборот»
  },
  "sound": {
    "enabled": true, // Звуки играют только на экране ТВ (синтезируются через Web Audio)
    "volume": 0.8 // Общая громкость 0…1
  }
}
